inks":{"hub":{"url":"https://walmart.org/how-we-give/program-guidelines/spark-good-local-grants-guidelines","label":"Walmart (private)"},"program":null,"audience":[]}}],"PROJECT_TYPES":[{"id":"ee","code":"EE","name":"Energy efficiency upgrades","ex":"HVAC, lighting, controls, insulation, air sealing, roof and envelope"},{"id":"elec","code":"EL","name":"Building electrification","ex":"Heat pumps, heat pump water heaters, induction, panel and service upgrades"},{"id":"solar","code":"PV","name":"Solar installation","ex":"Rooftop, ground mount, parking canopy, solar paired with storage"},{"id":"csolar","code":"CS","name":"Community solar","ex":"Subscriber projects, community-owned and community-driven solar"},{"id":"predev","code":"PD","name":"Predevelopment & soft costs","ex":"Feasibility, engineering, legal, site control, interconnection, permitting, outreach"},{"id":"storage","code":"ST","name":"Storage & resilience","ex":"Batteries, backup power, resilience hubs, virtual power plant enrollment"},{"id":"ev","code":"EV","name":"EV & fleet electrification","ex":"Chargers, fleet conversion, school and transit buses, depot infrastructure"},{"id":"workforce","code":"WF","name":"Workforce & contractor capacity","ex":"Training, apprenticeship, bonding, insurance, certification, prime readiness"},{"id":"newcon","code":"NC","name":"New construction & code","ex":"All-electric new build, stretch energy code adoption, affordable housing"},{"id":"plan","code":"PL","name":"Planning & organizational capacity","ex":"Energy plans, benchmarking ordinances, staff capacity, community engagement"},{"id":"capital","code":"GC","name":"General capital & construction","ex":"Hard costs, equipment purchase, construction, building acquisition and improvement"}],"AUDIENCES":[{"id":"cbo","name":"Community-based organization"},{"id":"muni","name":"Municipality"},{"id":"college","name":"College or university"},{"id":"smallbiz","name":"Small business owner"},{"id":"contractor","name":"Contractor / EEC"},{"id":"developer","name":"Developer"},{"id":"resident","name":"Resident / household"},{"id":"otheragency","name":"University staff / other agency staff"}],"STACKS":[{"id":"cbo","audience":"Community-Based Organization","project":"500 kW community solar — community center rooftop plus parking canopy","total":"$1,400,000","facts":["Nonprofit owner, no tax appetite","Subscribers are income-qualified households","18-month predevelopment runway"],"wf":[{"name":"CEJA Workforce Hub","note":"Recruit and place the install crew from the same community the array serves.","agency":"DCEO"},{"name":"Energy Transition Navigators","note":"Paid outreach staff to sign up income-qualified subscribers.","agency":"DCEO"},{"name":"Contractor Incubator + OEIT","note":"Get the community contractor bonded, insured and bid-ready before the RFP.","agency":"DCEO"}],"layers":[{"pct":15,"source":"Grant","program":"CSES Grant","url":"https://dceo.illinois.gov/ceja/other-ceja-programs.html","agency":"DCEO","color":"0D497F","note":"Predevelopment and development. Also unlocks EEF if you partner with an Equity Eligible Contractor."},{"pct":30,"source":"Incentive","program":"Illinois Shines — CDCS category","url":"https://illinoisshines.com/community-driven-community-solar/","agency":"IPA","color":"4A8FC7","note":"Upfront lump sum for 15 years of REC value. Scored application, minimum 6 points to contract."},{"pct":25,"source":"Tax credit, taken as cash","program":"48E via Elective Pay","url":"https://www.irs.gov/credits-deductions/elective-pay-and-transferability-frequently-asked-questions-overview","agency":"IRS","color":"E0A526","note":"A nonprofit gets the 30% credit as a direct payment. Most CBOs leave this on the table."},{"pct":25,"source":"Debt","program":"Climate Bank Finance / mission lender","url":"https://illinoisclimatebank.com/financing-programs/","agency":"IFA Climate Bank","color":"5A7488","note":"Rate bought down through an enrolled lender. Sized against subscriber revenue."},{"pct":5,"source":"Owner equity","program":"Capital campaign / reserves","agency":"Organization","color":"B6C9DA","note":"The smallest line and the hardest to raise. Start here, not last."}],"first":"First move: confirm elective pay eligibility before you size the debt. It changes every other number on the page."},{"id":"muni","audience":"Municipality","project":"Village hall and public works retrofit — heat pumps, LED, controls, 250 kW solar, 500 kWh storage","total":"$2,600,000","facts":["Tax-exempt owner, cannot use C-PACE","Bond capacity available but politically expensive","Facilities are 40+ years old"],"wf":[{"name":"Illinois workNet / OET","note":"Local workforce board funds on-the-job training for the village's own maintenance staff.","agency":"DCEO OET"},{"name":"Illinois Works bid credit","note":"Bid credit for apprentice hours on the public works contract.","agency":"DCEO OEIT"},{"name":"Primes Accelerator + Incubator","note":"Widens the bidder pool so the village gets more than two responses.","agency":"DCEO"}],"layers":[{"pct":10,"source":"Planning grant","program":"EECBG · Clean Energy Planning grants","url":"https://illinoisclimatebank.com/financing-programs/municipal-cooperative-utilities/clean-energy-planning/","agency":"IEPA / IFA","color":"0D497F","note":"Audits, energy plans, Stretch Code adoption. EECBG's last round was awarded Aug 2025 — confirm status."},{"pct":12,"source":"Rebate","program":"Utility efficiency incentives + free assessments","url":"https://www.comed.com/WaysToSave","agency":"ComEd / Ameren / Nicor","color":"4A8FC7","note":"Prescriptive plus custom. CRGA expands these budgets and triples the low-income minimum."},{"pct":22,"source":"Tax credit, taken as cash","program":"48E via Elective Pay — solar and storage","url":"https://www.irs.gov/credits-deductions/elective-pay-and-transferability-frequently-asked-questions-overview","agency":"IRS","color":"E0A526","note":"Storage keeps its longer runway. Solar starting now must be in service by Dec 31, 2027."},{"pct":10,"source":"Incentive","program":"Illinois Shines — Small DG + retail net metering","url":"https://illinoisshines.com/","agency":"IPA / ICC","color":"9DBEDA","note":"Upfront REC payment. Public schools and EEC projects get prioritized capacity."},{"pct":36,"source":"Debt","program":"ESPC, lease-purchase, GRID, or bridge loan","url":"https://illinoisclimatebank.com/financing-programs/","agency":"IFA / market","color":"5A7488","note":"ESPC moves this off the capital budget. GRID is grant money if the village owns its utility."},{"pct":10,"source":"Capital budget","program":"General fund, bond, or ETCG","url":"https://dceo.illinois.gov/ceja/other-ceja-programs.html","agency":"Village / DCEO","color":"B6C9DA","note":"ETCG covers predevelopment AND capital if the community had a plant or mine closure."}],"crossnote":"CROSS-CHECK against slide 21 of Helpful CEJA Slides. Also on the table for a village, even though it is not in this stack:\n• IEPA Office of Energy — Energy Code training and technical support, wastewater treatment plant energy assessments, Energy Efficiency Trust Fund.\n• IFA Climate Bank — Energy Sovereignty Loan for community ownership, Community Resilience Hubs, Community Charging, C-PACE for private property inside the village, Enabling Upgrades for Solar, Carbon Free Schools.\n• Fleet and transportation — IEPA Electric School Bus and EV Rebate, Charging Incentive Program, and IDOT's NEVI, Carbon Reduction Program, CMAQ and Competitive Freight-Port Infrastructure. Add these the moment the scope touches vehicles.\n• Codes and construction — Building Energy Codes, Stretch Energy Codes, Capital Development Board stretch goals.\n• Housing stock — IHDA Green Resilient Retrofit and Energy Efficiency Program, DCEO Weatherization Assistance.\n• People — Energy Equity Portal, Energy Transition Navigators, Workforce Hubs, Returning Residents, Climate Works.\n• Grid and rates — ICC net metering, Multi-Year Integrated Grid Plans, Equitable Energy Upgrade Program (still in rulemaking).\nNon-energy capital for the same building often sits in a DCEO community development or infrastructure NOFO. Search the full DCEO grant catalog, not just the CEJA page.","first":"First move: check whether the village owns its utility. If it does, GRID and the Small Utility Clean Energy Planning Grant are built only for you."},{"id":"smallbiz","audience":"Small Business Owner","project":"18,000 sf light industrial building — HVAC, envelope, LED, 100 kW rooftop solar","total":"$640,000","facts":["Owner-occupied, taxable entity","Existing banking relationship","Wants payback under 7 years"],"wf":[{"name":"SBDC / Business Information Center","note":"Free help sizing the loan package and the financial statements the lender wants.","agency":"DCEO OEIT"},{"name":"WIOA training dollars via OET","note":"Offsets the cost of retraining staff on the new equipment and controls.","agency":"DCEO OET"},{"name":"Contractor Incubator","note":"If the client is also the installer, this is the bonding and insurance line.","agency":"DCEO"}],"layers":[{"pct":15,"source":"Rebate","program":"Utility custom and prescriptive incentives","url":"https://www.amerenillinoissavings.com/","agency":"ComEd / Ameren / Nicor","color":"0D497F","note":"Apply before you buy equipment. Pre-approval is required on custom measures."},{"pct":12,"source":"Incentive","program":"Illinois Shines — Small DG","url":"https://illinoisshines.com/","agency":"IPA","color":"4A8FC7","note":"Paid through an Approved Vendor. The contractor must hold ICC DG installer certification."},{"pct":25,"source":"Tax credit","program":"Section 48E","url":"https://www.irs.gov/credits-deductions/elective-pay-and-transferability-frequently-asked-questions-overview","agency":"IRS","color":"E0A526","note":"30% base. Must be placed in service by Dec 31, 2027 unless construction started by July 4, 2026."},{"pct":8,"source":"Depreciation","program":"MACRS / bonus depreciation","agency":"IRS","color":"9DBEDA","note":"Real cash value in year one. Your client's CPA, not the installer, sizes this line."},{"pct":30,"source":"Debt","program":"SSBCI Loan Participation or C-PACE","url":"https://illinoisclimatebank.com/financing-programs/developers-contractors/state-small-business-credit-initiative-ssbci/","agency":"IFA Climate Bank","color":"5A7488","note":"SSBCI buys the rate down to 2% max, 1% if the owner qualifies as SEDI or very small business."},{"pct":10,"source":"Owner equity","program":"Cash or existing line","agency":"Business","color":"B6C9DA","note":"Ten percent is the realistic floor once the rebates and credits are stacked."}],"first":"First move: SSBCI is applied for through the client's own bank, not through IFA. Enroll the lender before you scope the project."}],"REGIONS":[{"id":"statewide","name":"Statewide"},{"id":"central","name":"Central","counties":["Cass","Christian","Greene","Logan","Macon","Macoupin","Menard","Montgomery","Morgan","Sangamon","Scott","Shelby"]},{"id":"eastcentral","name":"East Central","counties":["Champaign","Douglas","Ford","Iroquois","Piatt","Vermilion"]},{"id":"northcentral","name":"North Central","counties":["De Witt","Fulton","Livingston","McLean","Marshall","Mason","Peoria","Stark","Tazewell","Woodford"]},{"id":"northeast","name":"Northeast","counties":["Cook","DeKalb","DuPage","Grundy","Kane","Kankakee","Kendall","Lake","McHenry","Will"]},{"id":"northernstateline","name":"Northern Stateline","counties":["Boone","Ogle","Stephenson","Winnebago"]},{"id":"northwest","name":"Northwest","counties":["Bureau","Carroll","Henry","Jo Daviess","La Salle","Lee","Mercer","Putnam","Rock Island","Whiteside"]},{"id":"southeastern","name":"Southeastern","counties":["Clark","Clay","Coles","Crawford","Cumberland","Edgar","Effingham","Fayette","Jasper","Lawrence","Marion","Moultrie","Richland"]},{"id":"southern","name":"Southern","counties":["Alexander","Edwards","Franklin","Gallatin","Hamilton","Hardin","Jackson","Jefferson","Joh